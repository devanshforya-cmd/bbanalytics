# ==============================================================================
# Brand Bucket Command Center — Environment Variables Template
# Copy this file to .env.local and fill in the values for your environment.
# DO NOT COMMIT .env.local TO VERSION CONTROL!
# ==============================================================================

# Supabase Credentials (from Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# One-time administrator seed only; remove from runtime deployment after seeding.
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_initial_password

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron Authentication Secret (protects /api/cron/* endpoints)
CRON_SECRET=your_super_secret_cron_bearer_token_here

# Server-side HMAC key for signed, HttpOnly application sessions (32+ bytes)
AUTH_SESSION_SECRET=generate_a_random_secret_of_at_least_32_bytes

# Local-only preview login. Never enable this in production.
LOCAL_PREVIEW_AUTH=false
LOCAL_PREVIEW_PASSWORD=generate_a_unique_preview_password_at_least_16_chars

# Resend API Key for Email Delivery (Weekly Friday report & Critical Alerts)
RESEND_API_KEY=re_123456789_abcdefg
EMAIL_FROM="Brand Bucket Operations <operations@brandbucket.com.np>"
WEEKLY_REPORT_RECIPIENTS="admin@brandbucket.com.np,superadmin@brandbucket.com.np"

# Web-Push VAPID Keys for PWA Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BExamplePublicKeyHere...
VAPID_PRIVATE_KEY=ExamplePrivateKeyHere...
VAPID_SUBJECT="mailto:operations@brandbucket.com.np"

# Google OAuth for personal Google Drive + Sheets (recommended)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Google Drive & Google Sheets Service Account (for OpsCore exports & photo handovers)
GOOGLE_SERVICE_ACCOUNT_EMAIL=brand-bucket-service@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
GOOGLE_DRIVE_FOLDER_ID=1a2B3c4D5e6F7g8H9i0J_FolderId

# Next.js/Vercel supplies NODE_ENV automatically; do not override it.
